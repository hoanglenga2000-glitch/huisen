{
  "name": "huisen-tech",
  "version": "2.0.0",
  "description": "汇森科技 - B2B 专业手机批发平台",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/css/input.css -o ./dist/css/output.css --watch",
    "build": "npx tailwindcss -i ./src/css/input.css -o ./dist/css/output.css --minify",
